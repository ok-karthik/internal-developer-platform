apiVersion: v1
kind: Namespace
metadata:
  name: [[ .TeamName ]]
  labels:
    team: [[ .TeamName ]]
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: [[ .TeamName ]]-quota
  namespace: [[ .TeamName ]]
spec:
  hard:
    requests.cpu: "10"
    requests.memory: 20Gi
    limits.cpu: "20"
    limits.memory: 40Gi
    pods: "50"
---
apiVersion: v1
kind: LimitRange
metadata:
  name: [[ .TeamName ]]-limits
  namespace: [[ .TeamName ]]
spec:
  limits:
    - default:
        cpu: "500m"
        memory: "512Mi"
      defaultRequest:
        cpu: "100m"
        memory: "256Mi"
      type: Container
