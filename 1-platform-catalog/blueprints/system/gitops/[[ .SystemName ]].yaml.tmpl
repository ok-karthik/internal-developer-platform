apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: [[ .TeamName ]]-[[ .SystemName ]]
  namespace: argocd
spec:
  # https://argo-cd.readthedocs.io/en/stable/operator-manual/applicationset/Template/#go-templating
  goTemplate: true
  generators:
    - git:
        repoURL: 'https://github.com/ok-karthik/platform-engineering-idp-gitops-reference-architecture.git'
        revision: HEAD
        directories:
          - path: 3-tenant-workloads/[[ .TeamName ]]/gitops/systems/[[ .SystemName ]]/*/*
  template:
    metadata:
      # For path 3-tenant-workloads/team-a/gitops/systems/product-system/app-a/dev the
      # segments are 0=3-tenant-workloads 1=team-a 2=gitops 3=systems 4=product-system
      # 5=app-a 6=dev — so segment 5 is the app and basename is the env.
      name: '[[ .TeamName ]]-{{ index .path.segments 5 }}-{{ .path.basename }}'
    spec:
      project: [[ .TeamName ]]
      source:
        repoURL: 'https://github.com/ok-karthik/platform-engineering-idp-gitops-reference-architecture.git'
        targetRevision: HEAD
        path: '{{ .path.path }}/manifests'
      destination:
        server: 'https://kubernetes.default.svc'
        namespace: '[[ .TeamName ]]'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
