# Phase 7.7: a namespaced SecretStore, not a cluster-scoped
# ClusterSecretStore — same reasoning as Phase 7.4's RoleBinding-over-
# ClusterRole choice: [[ .TenantName ]]'s AppProject has
# `clusterResourceWhitelist: []`, so a cluster-scoped store could not be
# created through it, and a namespaced SecretStore keeps the tenancy
# boundary intact without needing a platform-owned singleton for something
# that is genuinely per-team (unlike platform-developer, every team's
# secrets backend is a distinct AWS principal, so there is nothing to share).
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: [[ .TenantName ]]-secrets
  namespace: [[ .TenantName ]]
spec:
  provider:
    aws:
      service: SecretsManager
      region: eu-central-1
      # No explicit role ARN here: the pod that reconciles this SecretStore
      # (the ESO controller, or a per-namespace SA if ESO's namespaced mode
      # is used) authenticates via IRSA/Pod Identity — the ServiceAccount's
      # OWN AWS identity is what scopes which secrets this store can reach,
      # matching every other capability's per-namespace IAM boundary.
      auth:
        jwt:
          serviceAccountRef:
            name: [[ .TenantName ]]-secrets
