#
# ACK path for the s3 capability (provisioner: ack in catalog.yaml). Lands in
# gitops/, not infra/, so ArgoCD — not a Terraform run — applies it. ACK
# reconciles this Bucket continuously with no plan step: deleting the CR
# deletes the live bucket with no review gate. That is the tradeoff that makes
# ACK right for a cheap, recreatable, per-app resource like this one and wrong
# for anything stateful (see the provisioner comment in catalog.yaml).
#
# The guardrails below are not tenant knobs — they mirror what
# 4-platform-engineering/cloud-services-terraform-modules/aws-s3/main.tf
# enforces (public-access block, encryption, versioning), because the argument
# for a platform abstraction over a raw resource does not change with the
# provisioner.
apiVersion: s3.services.k8s.aws/v1alpha1
kind: Bucket
metadata:
  name: [[ .TeamName ]]-[[ .AppName ]]-[[ .Env ]]
  namespace: [[ .TeamName ]]
  labels:
    team: [[ .TeamName ]]
    app: [[ .AppName ]]
    env: [[ .Env ]]
spec:
  name: [[ .TeamName ]]-[[ .AppName ]]-[[ .Env ]]
  # S3 bucket names are globally unique across every AWS account on earth.
  # Unlike the Terraform path (random_string suffix), ACK offers no built-in
  # collision-avoidance — a naming collision fails reconciliation loudly rather
  # than silently, which is an acceptable tradeoff for a cheap, recreatable
  # resource but is called out here since it differs from the .tf.tmpl path.
  publicAccessBlock:
    blockPublicACLs: true
    blockPublicPolicy: true
    ignorePublicACLs: true
    restrictPublicBuckets: true
  encryption:
    rules:
      - applyServerSideEncryptionByDefault:
          sseAlgorithm: AES256
  versioning:
    status: Enabled
  tags:
    - key: Team
      value: [[ .TeamName ]]
    - key: Service
      value: [[ .AppName ]]
    - key: Environment
      value: [[ .Env ]]
    - key: Capability
      value: s3
    - key: ManagedBy
      value: ack
