replicaCount: 1

image:
  repository: "ghcr.io/ok-karthik/platform-engineering-idp-gitops-reference-architecture/[[ .TeamName ]]/[[ .AppName ]]"
  pullPolicy: IfNotPresent
  tag: "latest"

imagePullSecrets: []
nameOverride: ""
fullnameOverride: ""

serviceAccount:
  create: true
  annotations: {}
  name: ""

podAnnotations:
  instrumentation.opentelemetry.io/inject-sdk: "[[ .AppName ]]-autoinstrumentation"

podLabels: 
  team: "[[ .TeamName ]]"

podSecurityContext: {}
securityContext: {}

service:
  type: ClusterIP
  port: 8080

resources: {}

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 20
  targetCPUUtilizationPercentage: 80

nodeSelector: {}
tolerations: []
affinity: {}

ingress:
  enabled: true
  annotations: {}
  hosts:
    - host: "[[ .AppName ]].[[ .TeamName ]].localhost"
      paths:
        - path: /
          pathType: Prefix
