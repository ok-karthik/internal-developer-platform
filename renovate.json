{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^2-idp-scaffolder/python/render\\.py$"
      ],
      "matchStrings": [
        "REMOTE_TEMPLATE_REPO = \"https://github\\.com/(?<depName>[^/]+/[^/@]+)@version=(?<currentValue>v[0-9.]+.*)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^1-platform-catalog/catalog\\.yaml$"
      ],
      "matchStrings": [
        "version:\\s*\"?(?<currentValue>v[0-9.]+.*)\"?"
      ],
      "depNameTemplate": "ok-karthik/internal-developer-platform",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "github-tags"
      ],
      "groupName": "IDP Template Version Updates"
    }
  ]
}